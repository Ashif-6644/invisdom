{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "invisdom-movie-api",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-23",
  "observability": { "enabled": false },
  "vars": {
    "ALLOWED_ORIGINS": "https://ashif-6644.github.io",
    "OPENAI_MODEL": "gpt-4o-mini",
    "DAILY_LIMIT": "100",
    "PER_CLIENT_DAILY_LIMIT": "5"
  },
  "durable_objects": { "bindings": [{ "name": "MOVIE_QUOTA", "class_name": "MovieQuota" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MovieQuota"] }]
}
